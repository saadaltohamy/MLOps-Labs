# Kaggle credentials (required for downloading data via kagglehub)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Weights & Biases (optional – wandb tracking is enabled when this key is set)
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=mlops-lab0

# MLflow (optional - Optuna trials are logged when this URI is set)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_USERNAME=your_mlflow_username
MLFLOW_TRACKING_PASSWORD=your_mlflow_password